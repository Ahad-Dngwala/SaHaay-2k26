{
  "name": "sahaay-server",
  "version": "1.0.0",
  "private": true,
  "description": "SaHaay in-memory dispatch server (Node + Express + ws, TypeScript, zero external dependencies)",
  "license": "FSL-1.1-ALv2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('src/control.html', 'dist/control.html'); fs.copyFileSync('src/sos.html', 'dist/sos.html')\"",
    "start": "node dist/index.js",
    "bench": "ts-node src/bench.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "node-fetch": "^2.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
