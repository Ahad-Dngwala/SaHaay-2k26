{
  "name": "sahaay-2k26",
  "version": "1.0.0",
  "private": true,
  "description": "SaHaay — offline-first emergency ambulance dispatch. Hack for Social Cause 2027.",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"server\" -c \"cyan\" \"npm run dev:server\"",
    "dev:server": "cd server && npx ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --testPathPattern=\"src/core|server/src\" --passWithNoTests",
    "test:ci": "jest --testPathPattern=\"src/core|server/src\" --runInBand",
    "test:smoke": "node scripts/smoke-test.js",
    "bench": "cd server && npx ts-node src/bench.ts",
    "build:server": "cd server && npm run build",
    "typecheck": "npx tsc --noEmit --project tsconfig.json && cd server && npx tsc --noEmit"
  },
  "workspaces": [
    "server"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/core",
      "<rootDir>/server/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "esModuleInterop": true,
            "moduleResolution": "node"
          }
        }
      ]
    }
  },
  "dependencies": {
    "@turf/along": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0"
  }
}
