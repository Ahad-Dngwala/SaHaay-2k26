# SaHaay-2k26 — Environment Configuration Template
# Copy this file to .env for local development

# ── Server & Runtime Environment ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Demo Director & Acceleration ───────────────────────────────────────────────
# DEMO_TIME_SCALE divides all dispatch and expansion timers (e.g. 10 = 10x speed)
DEMO_TIME_SCALE=1

# ── Dispatch Engine Parameters ─────────────────────────────────────────────────
# Initial radius around patient in metres (500m default)
SEARCH_RADIUS_M=500
# Expansion wait time per ring in seconds (120s default)
EXPAND_AFTER_S=120
# Expansion factor multiplier (2x default)
EXPAND_FACTOR=2
# Maximum search cap in metres (8000m default)
MAX_RADIUS_M=8000

# ── Crash Detection Parameters ─────────────────────────────────────────────────
# Sustained impact threshold in g (2.5g default)
CRASH_G=2.5
# Stillness post-impact confirmation window in milliseconds (1000ms default)
STILLNESS_WINDOW_MS=1000
# Cancellation countdown duration in seconds (30s default)
COUNTDOWN_SEC=30

# ── Admin Credentials (Development Seed) ───────────────────────────────────────
SAHAAY_ADMIN_EMAIL=admin@sahaay.gov.in
SAHAAY_ADMIN_PASSWORD=SaHaayAdmin2026!

# ── Client Application Endpoints ───────────────────────────────────────────────
# Web client base URL
VITE_API_URL=http://localhost:3000
# Android Emulator host loopback address
ANDROID_EMU_API_URL=http://10.0.2.2:3000
